# Guilty Spark - Agent configuration
# Copy to .env on each remote server and set these values.
# setup.sh generates this automatically.

# IP or hostname of the central monitoring server (where Loki listens on :3100)
CENTRAL_IP=192.168.1.10

# Display name for this server in Grafana dashboards (defaults to hostname)
INSTANCE_NAME=gpu01

# Enable GPU monitoring (set automatically by setup.sh when nvidia-smi is found)
# Remove or comment out to skip DCGM exporter on machines without GPUs
COMPOSE_PROFILES=gpu

# ─── Container images ───
# Override any image to use Iron Bank, an internal mirror, or a specific version.
# Must match the same images used on the central server.
#
# NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1
# PROCESS_EXPORTER_IMAGE=ncabatoff/process-exporter:0.8.7
# CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
# ALLOY_IMAGE=grafana/alloy:v1.16.1
# DCGM_IMAGE=nvidia/dcgm-exporter:4.5.2-4.8.1-ubuntu22.04
