# Guilty Spark - Central server configuration
# Copy to .env and adjust for your environment.
# setup.sh generates this automatically.

# Display name for this server in dashboards (defaults to hostname)
# INSTANCE_NAME=my-server

# Grafana admin credentials (change in production!)
# GF_ADMIN_USER=admin
# GF_ADMIN_PASSWORD=your-secure-password

# Enable GPU monitoring (set automatically by setup.sh when nvidia-smi is found)
# Remove or comment out to skip DCGM exporter on machines without GPUs
# COMPOSE_PROFILES=gpu

# ─── Container images ───
# Override any image to use Iron Bank, an internal mirror, or a specific version.
# Defaults (upstream) are used when unset.
#
# NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1
# PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
# LOKI_IMAGE=grafana/loki:3.7.2
# ALLOY_IMAGE=grafana/alloy:v1.16.1
# PROCESS_EXPORTER_IMAGE=ncabatoff/process-exporter:0.8.7
# CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
# GRAFANA_IMAGE=grafana/grafana:12.3.6-security-01
# DCGM_IMAGE=nvidia/dcgm-exporter:4.5.2-4.8.1-ubuntu22.04
#
# Iron Bank example:
# NODE_EXPORTER_IMAGE=registry1.dso.mil/ironbank/opensource/prometheus/node-exporter:v1.11.1
# PROMETHEUS_IMAGE=registry1.dso.mil/ironbank/opensource/prometheus/prometheus:v3.11.3
# LOKI_IMAGE=registry1.dso.mil/ironbank/opensource/grafana/loki:3.7.2
# ALLOY_IMAGE=registry1.dso.mil/ironbank/opensource/grafana/alloy:v1.16.1
# GRAFANA_IMAGE=registry1.dso.mil/ironbank/opensource/grafana/grafana:12.3.6
