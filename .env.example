# Guilty Spark — Optional overrides
# Copy to .env and adjust for your environment

# Enable GPU monitoring (set automatically by setup.sh when nvidia-smi is found)
# Remove or comment out to skip DCGM exporter on machines without GPUs
# COMPOSE_PROFILES=gpu

# DCGM Exporter image — use different tag for older systems if needed
# DCGM_IMAGE=nvidia/dcgm-exporter:4.4.2-4.7.1-ubuntu22.04

# Display name for this server in dashboards (defaults to "local")
# INSTANCE_NAME=local

# Grafana admin credentials (change in production!)
# GF_ADMIN_USER=admin
# GF_ADMIN_PASSWORD=your-secure-password
