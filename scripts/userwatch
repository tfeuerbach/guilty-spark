#!/usr/bin/env bash
# Watch for user database changes and regenerate alloy config.
# Installed as a systemd service by setup.sh.
#
# Watches:
#   /etc/passwd       - local user changes
#   /etc/shadow       - password changes (useradd completion)
#   /var/lib/sss/db/  - SSSD cache updates (AD/LDAP)

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
GENERATE_SCRIPT="$REPO_ROOT/scripts/generate-user-metrics.sh"

DEBOUNCE_SECONDS=3
last_run=0

run_generator() {
    local now
    now=$(date +%s)
    # Debounce: don't run more than once per DEBOUNCE_SECONDS
    if (( now - last_run < DEBOUNCE_SECONDS )); then
        return 0
    fi
    last_run=$now
    echo "[$(date -Iseconds)] User database changed, regenerating metrics and alloy config"
    "$GENERATE_SCRIPT" 2>&1 || true
}

# Build watch list (only paths that exist)
WATCH_PATHS=()
for path in /etc/passwd /etc/shadow; do
    [ -f "$path" ] && WATCH_PATHS+=("$path")
done
# SSSD cache directory (AD/LDAP)
[ -d /var/lib/sss/db ] && WATCH_PATHS+=("/var/lib/sss/db/")

if [ ${#WATCH_PATHS[@]} -eq 0 ]; then
    echo "ERROR: No watchable paths found" >&2
    exit 1
fi

if ! command -v inotifywait &>/dev/null; then
    echo "ERROR: inotifywait not found. Install inotify-tools." >&2
    exit 1
fi

echo "Guilty Spark userwatch started"
echo "  Watching: ${WATCH_PATHS[*]}"
echo "  Generator: $GENERATE_SCRIPT"
echo "  Debounce: ${DEBOUNCE_SECONDS}s"

# Initial run to ensure config is current
run_generator

# Watch for modifications (inotifywait blocks until an event occurs)
while true; do
    inotifywait -qq -e modify -e create -e moved_to "${WATCH_PATHS[@]}" 2>/dev/null
    run_generator
done
