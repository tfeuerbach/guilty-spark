# guilty-spark alloy config (central node, promtail format)
# For agent nodes, see agent.yml.tmpl.
#
# NOTE: This file is a TEMPLATE. Do not edit config.yml directly.
# Run scripts/generate-user-metrics.sh to regenerate config.yml.
server:
  http_listen_port: 9080
  grpc_listen_port: 0
positions:
  filename: /tmp/positions.yaml
clients:
  - url: http://loki:3100/loki/api/v1/push
scrape_configs:
  # Laurel JSON audit (preferred)
  - job_name: laurel
    static_configs:
      - targets:
          - localhost
        labels:
          job: audit
          instance: ${INSTANCE_NAME}
          __path__: /var/log/laurel/audit.json
    pipeline_stages:
      - json:
          expressions:
            type: type
            uid: uid
            auid: auid
            pid: pid
            exe: exe
            msg: msg
      - template:
          source: username
          template: '@@USER_MAP@@'
      - labels:
          type: type
          auid: auid
          username: username
      - output:
          source: msg
  # Raw audit.log (fallback if no Laurel)
  - job_name: audit
    static_configs:
      - targets:
          - localhost
        labels:
          job: audit_raw
          instance: ${INSTANCE_NAME}
          __path__: /var/log/audit/audit.log
    pipeline_stages:
      - regex:
          expression: 'auid=(?P<auid>\d+)'
      - template:
          source: username
          template: '@@USER_MAP@@'
      - labels:
          auid: auid
          username: username
  # Auth log (Debian/Ubuntu)
  - job_name: auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          instance: ${INSTANCE_NAME}
          __path__: /var/log/auth.log
    pipeline_stages:
      - regex:
          expression: '(?:session opened for user |Accepted \S+ for |sudo:\s+)(?P<username>\w+)'
      - labels:
          username: username
  # Auth log (RHEL/AlmaLinux/Rocky)
  - job_name: auth_secure
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          instance: ${INSTANCE_NAME}
          __path__: /var/log/secure
    pipeline_stages:
      - regex:
          expression: '(?:session opened for user |Accepted \S+ for |sudo:\s+)(?P<username>\w+)'
      - labels:
          username: username
  # Shell history
  - job_name: shell_history
    static_configs:
      - targets:
          - localhost
        labels:
          job: shell_history
          instance: ${INSTANCE_NAME}
          __path__: /var/log/shell-history.log
    pipeline_stages:
      - regex:
          expression: 'user=(?P<username>\S+)\s+tty=\S+\s+cmd=(?P<cmd>.+)$'
      - labels:
          username: username
  # Snoopy Logger (execve capture)
  - job_name: snoopy
    static_configs:
      - targets:
          - localhost
        labels:
          job: snoopy
          instance: ${INSTANCE_NAME}
          __path__: /var/log/snoopy.log
    pipeline_stages:
      - regex:
          expression: '\[login:(?P<username>\w+).*?\]:\s*(?P<cmd>.+)$'
      - labels:
          username: username
