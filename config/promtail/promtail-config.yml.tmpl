# Guilty Spark — Promtail config (audit + auth logs → Loki)
# Central/local node config. For agent nodes, see promtail-agent.yml.tmpl.
# Uses env var expansion (-config.expand-env=true):
#   INSTANCE_NAME — hostname of this server (set via .env / docker-compose)
# Supports both Debian (auth.log) and RHEL (secure) auth log paths.
#
# NOTE: This file is a TEMPLATE. Do not edit promtail-config.yml directly.
# Run scripts/generate-user-metrics.sh to regenerate promtail-config.yml
# with the current UID→username map from /etc/passwd.
server:
  http_listen_port: 9080
  grpc_listen_port: 0
positions:
  filename: /tmp/positions.yaml
clients:
  - url: http://loki:3100/loki/api/v1/push
scrape_configs:
  # Laurel JSON audit (preferred)
  - job_name: laurel
    static_configs:
      - targets:
          - localhost
        labels:
          job: audit
          instance: ${INSTANCE_NAME}
          __path__: /var/log/laurel/audit.json
    pipeline_stages:
      - json:
          expressions:
            type: type
            uid: uid
            auid: auid
            pid: pid
            exe: exe
            msg: msg
      - template:
          source: username
          template: '@@USER_MAP@@'
      - labels:
          type: type
          auid: auid
          username: username
      - output:
          source: msg
  # Raw audit.log (fallback if no Laurel)
  - job_name: audit
    static_configs:
      - targets:
          - localhost
        labels:
          job: audit_raw
          instance: ${INSTANCE_NAME}
          __path__: /var/log/audit/audit.log
    pipeline_stages:
      - regex:
          expression: 'auid=(?P<auid>\d+)'
      - template:
          source: username
          template: '@@USER_MAP@@'
      - labels:
          auid: auid
          username: username
  # Auth log — Debian/Ubuntu
  - job_name: auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          instance: ${INSTANCE_NAME}
          __path__: /var/log/auth.log
    pipeline_stages:
      - regex:
          expression: '(?:session opened for user |Accepted \S+ for |sudo:\s+)(?P<username>\w+)'
      - labels:
          username: username
  # Auth log — RHEL/AlmaLinux/Rocky (same pipeline, different path)
  - job_name: auth_secure
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          instance: ${INSTANCE_NAME}
          __path__: /var/log/secure
    pipeline_stages:
      - regex:
          expression: '(?:session opened for user |Accepted \S+ for |sudo:\s+)(?P<username>\w+)'
      - labels:
          username: username
