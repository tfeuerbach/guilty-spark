# Guilty Spark — Promtail config for agent nodes
# Pushes audit + auth logs to the central Loki instance.
# Uses env var expansion (-config.expand-env=true):
#   CENTRAL_IP    — IP/hostname of the central server
#   INSTANCE_NAME — friendly name for this server
# Supports both Debian (auth.log) and RHEL (secure) auth log paths.
#
# NOTE: This file is a TEMPLATE. Do not edit promtail-agent.yml directly.
# Run scripts/generate-user-metrics.sh to regenerate promtail-agent.yml
# with the current UID→username map from /etc/passwd.
server:
  http_listen_port: 9080
  grpc_listen_port: 0
positions:
  filename: /tmp/positions.yaml
clients:
  - url: http://${CENTRAL_IP}:3100/loki/api/v1/push
scrape_configs:
  - job_name: laurel
    static_configs:
      - targets:
          - localhost
        labels:
          job: audit
          instance: ${INSTANCE_NAME}
          __path__: /var/log/laurel/audit.json
    pipeline_stages:
      - json:
          expressions:
            type: type
            uid: uid
            auid: auid
            pid: pid
            exe: exe
            msg: msg
      - template:
          source: username
          template: '@@USER_MAP@@'
      - labels:
          type: type
          auid: auid
          username: username
      - output:
          source: msg
  - job_name: audit
    static_configs:
      - targets:
          - localhost
        labels:
          job: audit_raw
          instance: ${INSTANCE_NAME}
          __path__: /var/log/audit/audit.log
    pipeline_stages:
      - regex:
          expression: 'auid=(?P<auid>\d+)'
      - template:
          source: username
          template: '@@USER_MAP@@'
      - labels:
          auid: auid
          username: username
  - job_name: auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          instance: ${INSTANCE_NAME}
          __path__: /var/log/auth.log
    pipeline_stages:
      - regex:
          expression: '(?:session opened for user |Accepted \S+ for |sudo:\s+)(?P<username>\w+)'
      - labels:
          username: username
  - job_name: auth_secure
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          instance: ${INSTANCE_NAME}
          __path__: /var/log/secure
    pipeline_stages:
      - regex:
          expression: '(?:session opened for user |Accepted \S+ for |sudo:\s+)(?P<username>\w+)'
      - labels:
          username: username
  # Shell history — exact typed commands (bash PROMPT_COMMAND + zsh precmd)
  - job_name: shell_history
    static_configs:
      - targets:
          - localhost
        labels:
          job: shell_history
          instance: ${INSTANCE_NAME}
          __path__: /var/log/shell-history.log
    pipeline_stages:
      - regex:
          expression: 'user=(?P<username>\S+)\s+tty=\S+\s+cmd=(?P<cmd>.+)$'
      - labels:
          username: username
  # Snoopy Logger — full execve capture with arguments
  - job_name: snoopy
    static_configs:
      - targets:
          - localhost
        labels:
          job: snoopy
          instance: ${INSTANCE_NAME}
          __path__: /var/log/snoopy.log
    pipeline_stages:
      - regex:
          expression: '\[uid:(?P<uid>\d+)\s+.*?username:(?P<username>\w+).*?\]:\s*(?P<cmd>.+)$'
      - labels:
          username: username
