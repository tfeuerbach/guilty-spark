{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "bolt",
      "tags": [],
      "title": "GPU Dashboard",
      "type": "link",
      "url": "/d/dcgm-gpu"
    },
    {
      "icon": "bolt",
      "tags": [],
      "title": "User Activity",
      "type": "link",
      "url": "/d/audit-activity"
    },
    {
      "icon": "bolt",
      "tags": [],
      "title": "Network Deep Dive",
      "type": "link",
      "url": "/d/network-deep-dive"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "CPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "$node",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{instance=~\"$node\",job=~\"$job\",mode=\"idle\"}[5m]))) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "$node",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{instance=~\"$node\",job=~\"$job\"} / node_memory_MemTotal_bytes{instance=~\"$node\",job=~\"$job\"}) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Disk",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "$node",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 15 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "(1 - node_filesystem_avail_bytes{instance=~\"$node\",job=~\"$job\",mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{instance=~\"$node\",job=~\"$job\",mountpoint=\"/\",fstype!=\"tmpfs\"}) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Uptime & Hardware",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "$node",
      "description": "Uptime / CPU cores / RAM",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "repeat": "node",
      "repeatDirection": "h",
      "maxPerRow": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Cores" },
            "properties": [{ "id": "unit", "value": "none" }]
          },
          {
            "matcher": { "id": "byName", "options": "RAM" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 22 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "node_time_seconds{instance=~\"$node\",job=~\"$job\"} - node_boot_time_seconds{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "Uptime",
          "refId": "A"
        },
        {
          "expr": "count(count(node_cpu_seconds_total{instance=~\"$node\",job=~\"$job\"}) by (cpu))",
          "legendFormat": "Cores",
          "refId": "B"
        },
        {
          "expr": "node_memory_MemTotal_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "RAM",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Utilization Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": { "mode": "normal" },
            "spanNulls": true,
            "axisCenteredZero": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (instance, mode)(rate(node_cpu_seconds_total{instance=~\"$node\",job=~\"$job\",mode!=\"idle\"}[5m])) / on(instance) group_left count by (instance)(count(node_cpu_seconds_total{instance=~\"$node\",job=~\"$job\"}) by (instance, cpu)) * 100",
          "legendFormat": "{{instance}} {{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": { "mode": "normal" },
            "spanNulls": true,
            "axisCenteredZero": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{instance=~\"$node\",job=~\"$job\"} - node_memory_MemAvailable_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Used",
          "refId": "A"
        },
        {
          "expr": "node_memory_Cached_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Cached",
          "refId": "B"
        },
        {
          "expr": "node_memory_Buffers_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Buffers",
          "refId": "C"
        },
        {
          "expr": "node_memory_MemFree_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Free",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": { "mode": "none" },
            "spanNulls": true,
            "axisCenteredZero": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{instance=~\"$node\",job=~\"$job\",device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{instance}} {{device}} rx",
          "refId": "A"
        },
        {
          "expr": "-rate(node_network_transmit_bytes_total{instance=~\"$node\",job=~\"$job\",device!~\"lo|veth.*|docker.*|br-.*\"}[5m])",
          "legendFormat": "{{instance}} {{device}} tx",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Space Usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": { "mode": "normal" },
            "spanNulls": true,
            "axisCenteredZero": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "node_filesystem_size_bytes{instance=~\"$node\",job=~\"$job\",fstype!~\"tmpfs|overlay\"} - node_filesystem_avail_bytes{instance=~\"$node\",job=~\"$job\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{instance}} {{mountpoint}} used",
          "refId": "A"
        },
        {
          "expr": "node_filesystem_avail_bytes{instance=~\"$node\",job=~\"$job\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{instance}} {{mountpoint}} available",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "System Load",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "System Load Average",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": { "mode": "none" },
            "spanNulls": true,
            "axisCenteredZero": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "node_load1{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} 1m",
          "refId": "A"
        },
        {
          "expr": "node_load5{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} 5m",
          "refId": "B"
        },
        {
          "expr": "node_load15{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} 15m",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk I/O",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 15,
            "stacking": { "mode": "none" },
            "spanNulls": true,
            "axisCenteredZero": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{instance=~\"$node\",job=~\"$job\",device=~\"$diskdevices\"}[5m])",
          "legendFormat": "{{instance}} {{device}} read",
          "refId": "A"
        },
        {
          "expr": "-rate(node_disk_written_bytes_total{instance=~\"$node\",job=~\"$job\",device=~\"$diskdevices\"}[5m])",
          "legendFormat": "{{instance}} {{device}} write",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["guilty-spark", "node-exporter"],
  "templating": {
