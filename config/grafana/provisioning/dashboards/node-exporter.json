      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{instance=~\"$node\",job=~\"$job\"} - node_memory_MemAvailable_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Used",
          "refId": "A"
        },
        {
          "expr": "node_memory_Cached_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Cached",
          "refId": "B"
        },
        {
          "expr": "node_memory_Buffers_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Buffers",
          "refId": "C"
        },
        {
          "expr": "node_memory_MemFree_bytes{instance=~\"$node\",job=~\"$job\"}",
          "legendFormat": "{{instance}} Free",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
