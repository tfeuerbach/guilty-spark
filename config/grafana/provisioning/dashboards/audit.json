    {
      "type": "logs",
      "title": "Typed commands (bash + zsh)",
      "description": "Exact command lines as typed by users, captured via PROMPT_COMMAND / precmd hooks",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"shell_history\", username=~\"$user\", instance=~\"$instance\"} | regexp `cmd=(?P<cmd>.+)$` | line_format \"{{.username}} on {{.instance}} ran '{{.cmd}}'\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
