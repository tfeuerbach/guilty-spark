            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=~\"audit|audit_raw\", username=~\"$user\", instance=~\"$instance\"} |~ \"comm\" !~ \"cron|auditd|audispd|systemd-journal|laurel|guilty-spark\" | regexp `comm[=:]\\\"(?P<command>[^\\\"]*)\\\"` | regexp `exe[=:]\\\"(?P<executable>[^\\\"]*)\\\"` | regexp `res[=:](?P<result>\\w+)` | command !~ \"^(logger|tty|whoami|sed|basename)$\" | line_format \"{{.username}} on {{.instance}} executed {{.command}} ({{.executable}})\"",
          "queryType": "range",
          "refId": "A"
