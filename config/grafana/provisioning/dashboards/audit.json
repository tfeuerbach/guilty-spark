    {
      "type": "logs",
      "title": "Snoopy \u2014 all executed processes",
      "description": "Every execve() captured by Snoopy with full arguments",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"snoopy\", username=~\"$user\", instance=~\"$instance\"} !~ \"cron|auditd|systemd|alloy|guilty-spark\" | regexp `\\]:\\s*(?P<cmd>.+)$` | cmd !~ \"^(logger|tty|whoami|sed|basename) \" | cmd !~ \"/proc/.*/fd\" | line_format \"{{.username}} ran {{.cmd}} on {{.instance}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Audit \u2014 commands (auditd / Laurel)",
