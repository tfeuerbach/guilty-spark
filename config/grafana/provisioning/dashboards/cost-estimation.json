  "panels": [
    {
      "type": "stat",
      "title": "Total Infrastructure Cost",
      "description": "Combined on-premise + EC2 costs for the selected time range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "0.00"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "((sum(avg_over_time(DCGM_FI_DEV_GPU_UTIL{instance=~\"$instance\"}[$__range]) / 100 unless on(instance) guilty_spark_ec2_cost_per_hour) * ($__range_s / 3600) * $gpu_rate) or vector(0)) + ((sum(avg_over_time(DCGM_FI_DEV_POWER_USAGE{instance=~\"$instance\"}[$__range]) unless on(instance) guilty_spark_ec2_cost_per_hour) * $__range_s / 3600 / 1000 * $kwh_rate) or vector(0)) + ((sum(guilty_spark_user_disk_bytes{instance=~\"$instance\"} unless on(instance) guilty_spark_ec2_cost_per_hour) / 1073741824 * $storage_rate) or vector(0)) + ((sum(increase(node_network_transmit_bytes_total{instance=~\"$instance\", device!~\"lo|veth.*|docker.*|br-.*\"}[$__range]) unless on(instance) guilty_spark_ec2_cost_per_hour) / 1073741824 * $network_rate) or vector(0)) + ((sum(guilty_spark_ec2_cost_per_hour{instance=~\"$instance\"}) * $__range_s / 3600) or vector(0))",
          "refId": "A"
        }
      ]
    },
