      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (ip) (count_over_time({job=\"auth\", instance=~\"$instance\"} |~ \"Failed|authentication failure\" | regexp `from (?P<ip>\\d+\\.\\d+\\.\\d+\\.\\d+)` [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
