        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Port",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "expr": "guilty_spark_listening_port{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "Value": true
            },
            "renameByName": {
              "instance": "Server",
              "port": "Port",
              "process": "Process"
            }
          }
        }
      ]
