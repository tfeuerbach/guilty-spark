  "refresh": "30s",
  "schemaVersion": 38,
  "tags": [
    "containers",
    "docker",
    "guilty-spark"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(container_last_seen, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Server",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(container_last_seen, instance)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
